{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "npm install -g corepack",
        "corepack enable",
        "pnpm install --no-frozen-lockfile",
        "pnpm build:web",
        "chmod +x /app/docker-entrypoint.sh"
      ],
      "deployOutputs": [
        {
          "include": [
            "/app/out",
            "/app/web/dist",
            "/app/docker-entrypoint.sh"
          ]
        }
      ]
    },
    "build-pp": {
      "inputs": [
        {
          "image": "mcr.microsoft.com/dotnet/sdk:8.0"
        },
        {
          "local": true,
          "include": [
            "pp"
          ]
        }
      ],
      "commands": [
        "test -f /app/pp/AimMod.Pp.csproj",
        "dotnet publish /app/pp/AimMod.Pp.csproj -c Release -o /app/pp-runtime"
      ],
      "deployOutputs": [
        {
          "include": [
            "/app/pp-runtime"
          ]
        }
      ]
    }
  },
  "deploy": {
    "variables": {
      "AIMMOD_HUB_STATIC_DIR": "/app/web/dist",
      "AIMMOD_HUB_BINARY": "/app/out",
      "AIMMOD_PP_DLL": "/app/pp-runtime/AimMod.Pp.dll"
    },
    "base": {
      "image": "mcr.microsoft.com/dotnet/aspnet:8.0"
    },
    "startCommand": "/app/docker-entrypoint.sh"
  }
}
