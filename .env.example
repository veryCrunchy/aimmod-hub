DATABASE_URL=postgres://postgres:postgres@localhost:5432/aimmod_hub?sslmode=disable
AIMMOD_HUB_ADDR=:8080
AIMMOD_HUB_VERSION=dev
AIMMOD_HUB_WEB_ORIGIN=http://localhost:5173
AIMMOD_HUB_API_BASE_URL=http://localhost:8080
# Official osu! API OAuth application credentials. Use a client-credentials
# application with the public scope; keep the secret on the Hub server.
AIMMOD_OSU_CLIENT_ID=
AIMMOD_OSU_CLIENT_SECRET=
# Provider responses are cached in memory and outbound requests are paced per provider.
AIMMOD_OSU_CACHE_TTL=5m
AIMMOD_OSU_CACHE_MAX_ENTRIES=256
AIMMOD_OSU_PROVIDER_RPS=4
AIMMOD_OSU_REQUEST_TIMEOUT=10s
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
AIMMOD_HUB_ADMIN_DISCORD_USER_ID=
SESSION_COOKIE_SECURE=false
# Set to web/dist to serve the frontend from the API with SSR meta injection (Mode B).
# Leave unset to serve the frontend via Nginx separately (Mode A).
AIMMOD_HUB_STATIC_DIR=
# Optional directory to serve local-coach runtime assets and model files under /llm/.
# Example files:
#   $AIMMOD_HUB_LLM_DIR/manifest.json
#   $AIMMOD_HUB_LLM_DIR/runtime/windows-x64/llama.cpp-runtime.zip
#   $AIMMOD_HUB_LLM_DIR/models/aimmod-coach.gguf
AIMMOD_HUB_LLM_DIR=
# Optional env-driven /llm/manifest.json for upstream-hosted assets.
# This is the recommended production path when the heavy files live on
# official upstream hosts like GitHub Releases or Hugging Face.
AIMMOD_HUB_LLM_MANIFEST_VERSION=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_URL=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_SHA256=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_ARCHIVE_TYPE=zip
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_EXTRA_URL=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_EXTRA_SHA256=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_X64_EXTRA_ARCHIVE_TYPE=zip
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_URL=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_SHA256=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_ARCHIVE_TYPE=zip
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_EXTRA_URL=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_EXTRA_SHA256=
AIMMOD_HUB_LLM_RUNTIME_WINDOWS_ARM64_EXTRA_ARCHIVE_TYPE=zip
AIMMOD_HUB_LLM_MODEL_URL=
AIMMOD_HUB_LLM_MODEL_SHA256=
AIMMOD_HUB_LLM_MODEL_FILENAME=aimmod-coach.gguf
VITE_API_BASE_URL=http://localhost:8080
AIMMOD_HUB_MEDIA_BACKEND=local
AIMMOD_HUB_MEDIA_DIR=./var/media
AIMMOD_HUB_S3_BUCKET=
AIMMOD_HUB_S3_REGION=auto
AIMMOD_HUB_S3_ENDPOINT=
AIMMOD_HUB_S3_ACCESS_KEY_ID=
AIMMOD_HUB_S3_SECRET_ACCESS_KEY=
AIMMOD_HUB_S3_FORCE_PATH_STYLE=false
